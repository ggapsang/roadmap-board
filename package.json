{
  "name": "wolfpack",
  "version": "0.1.0",
  "description": "WOLFPACK — 시간축 위에서 일정을 편집·공유하는 프로젝트 보드",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "example-db": "electron scripts/make-example-db.mjs",
    "dist": "electron-builder --win --x64",
    "test": "electron . --smoke"
  },
  "author": "다임리서치",
  "license": "UNLICENSED",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "d3-force": "^3.0.0"
  },
  "build": {
    "appId": "kr.daim.wolfpack",
    "productName": "WOLFPACK",
    "files": [
      "index.html",
      "src/**/*",
      "electron/**/*",
      "package.json",
      "assets/**/*",
      "docs/HELP.md"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "extraResources": [
      {
        "from": "build",
        "to": ".",
        "filter": [
          "example.db"
        ]
      }
    ]
  },
  "devDependencies": {
    "electron": "^44.4.4",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "electron-winstaller@5.4.0": true
  }
}
